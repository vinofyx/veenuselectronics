# ------------------------------------------------------------------
# Veenus Electronics - environment variables
# Copy to .env.local for development and add the same keys in Vercel.
# See docs/ENVIRONMENT.md for a description of every variable.
# ------------------------------------------------------------------

# Public site URL (no trailing slash). Used for canonical URLs, sitemap, Open Graph.
NEXT_PUBLIC_SITE_URL=https://www.example.com

# ---------- Business details (leave blank until verified) ----------
# Blank values are hidden on the website - nothing is invented.
NEXT_PUBLIC_BUSINESS_PHONE=            # e.g. +919876543210 (E.164, with country code)
NEXT_PUBLIC_BUSINESS_PHONE_DISPLAY=    # e.g. +91 98765 43210
NEXT_PUBLIC_WHATSAPP_NUMBER=           # digits only incl. country code, e.g. 919876543210
NEXT_PUBLIC_BUSINESS_EMAIL=
NEXT_PUBLIC_BUSINESS_ADDRESS_STREET=
NEXT_PUBLIC_BUSINESS_ADDRESS_LOCALITY=
NEXT_PUBLIC_BUSINESS_CITY=Hyderabad
NEXT_PUBLIC_BUSINESS_STATE=Telangana
NEXT_PUBLIC_BUSINESS_POSTCODE=
NEXT_PUBLIC_BUSINESS_LAT=
NEXT_PUBLIC_BUSINESS_LNG=
NEXT_PUBLIC_GOOGLE_MAPS_URL=           # "Share" link of the shop on Google Maps
NEXT_PUBLIC_GOOGLE_REVIEWS_URL=        # link to your Google Business reviews
NEXT_PUBLIC_WORKING_HOURS=             # e.g. Mon-Sat 10:00 AM - 8:00 PM
NEXT_PUBLIC_YEARS_EXPERIENCE=          # number only, e.g. 12  (leave blank if not verified)
NEXT_PUBLIC_WARRANTY_TEXT=             # e.g. 90-day warranty on replaced parts (leave blank if not offered)

# ---------- Supabase ----------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SERVER ONLY - never prefix with NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=

# ---------- Notifications (server only) ----------
# Email via Resend (https://resend.com). Leave blank to disable email.
RESEND_API_KEY=
ENQUIRY_NOTIFY_EMAIL=                  # where new-enquiry alerts are sent (comma-separated allowed)
ENQUIRY_FROM_EMAIL=                    # verified sender, e.g. "Veenus Website <alerts@yourdomain.com>"

# Secret used to hash IP addresses for rate limiting (any long random string)
RATE_LIMIT_SALT=

# ---------- Analytics / verification ----------
NEXT_PUBLIC_GA_MEASUREMENT_ID=         # G-XXXXXXXXXX
NEXT_PUBLIC_GSC_VERIFICATION=          # Google Search Console HTML-tag content value
